{
  "color": {
    "$type": "color",
    "palette": {
      "$description": "Raw palette. Components should reference semantic tokens, not these.",
      "blue-600": { "$value": "#3B5BDB" },
      "blue-700": { "$value": "#2F4AC0" },
      "neutral-0": { "$value": "#FFFFFF" },
      "neutral-50": { "$value": "#F8F9FA" },
      "neutral-200": { "$value": "#E5E7EB" },
      "neutral-600": { "$value": "#4B5563" },
      "neutral-900": { "$value": "#111827" },
      "green-700": { "$value": "#2B8A3E" },
      "amber-700": { "$value": "#B35C00" },
      "red-700": { "$value": "#C92A2A" },
      "green-50": { "$value": "#EBFBEE" },
      "amber-50": { "$value": "#FFF4E6" },
      "red-50": { "$value": "#FFF5F5" }
    },
    "text": {
      "default": { "$value": "{color.palette.neutral-900}", "$description": "Body and heading text." },
      "muted": { "$value": "{color.palette.neutral-600}", "$description": "Secondary text, hints, captions." },
      "on-action": { "$value": "{color.palette.neutral-0}", "$description": "Text on primary and danger buttons." },
      "link": { "$value": "{color.palette.blue-600}", "$description": "Inline links." }
    },
    "surface": {
      "default": { "$value": "{color.palette.neutral-0}", "$description": "Cards, inputs, page background." },
      "subtle": { "$value": "{color.palette.neutral-50}", "$description": "Secondary areas and hover states." }
    },
    "border": {
      "default": { "$value": "{color.palette.neutral-200}", "$description": "Dividers, card and input borders." },
      "focus": { "$value": "{color.palette.blue-600}", "$description": "Focus rings." }
    },
    "action": {
      "primary": { "$value": "{color.palette.blue-600}", "$description": "Primary buttons. At most one per view." },
      "primary-hover": { "$value": "{color.palette.blue-700}", "$description": "Primary button hover." },
      "danger": { "$value": "{color.palette.red-700}", "$description": "Destructive actions only." }
    },
    "feedback": {
      "success": { "$value": "{color.palette.green-700}" },
      "success-surface": { "$value": "{color.palette.green-50}" },
      "warning": { "$value": "{color.palette.amber-700}" },
      "warning-surface": { "$value": "{color.palette.amber-50}" },
      "danger": { "$value": "{color.palette.red-700}" },
      "danger-surface": { "$value": "{color.palette.red-50}" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px-based spacing scale. Use only these steps for padding, margin and gap.",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "border-width": {
    "$type": "dimension",
    "default": { "$value": "1px" },
    "focus": { "$value": "2px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "28px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    }
  }
}
